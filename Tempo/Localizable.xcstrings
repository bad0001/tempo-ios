      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a period of time to sit quietly and breathe along the circle. When finished, the mindfulness duration of Apple Health will be automatically written. \n\nTwo-person simultaneous meditation mode will be launched in a future version."
